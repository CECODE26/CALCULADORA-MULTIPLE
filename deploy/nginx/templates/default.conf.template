# Plantilla procesada por envsubst al arrancar el contenedor (variable: DOMAIN).
# Las variables propias de Nginx se escriben con $ normal; solo ${DOMAIN} se sustituye.

proxy_cache_path /var/cache/nginx/next levels=1:2 keys_zone=next_cache:20m max_size=500m inactive=7d use_temp_path=off;
limit_req_zone $binary_remote_addr zone=req_per_ip:10m rate=20r/s;

upstream nextjs {
    server app:3000;
    keepalive 32;
}

# ── HTTP: desafío ACME + redirección a HTTPS ──
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /nginx-health {
        access_log off;
        return 200 "ok";
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# ── HTTPS: www → dominio canónico ──
server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};
    include /etc/nginx/snippets/ssl.conf;
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    return 301 https://${DOMAIN}$request_uri;
}

# ── HTTPS: sitio ──
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    include /etc/nginx/snippets/ssl.conf;
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 1m;
    server_tokens off;

    include /etc/nginx/snippets/compression.conf;

    # Nota: no usar add_header dentro de los location (anularía la cabecera HSTS heredada).

    # Archivos estáticos con hash: Next.js ya envía "immutable"; Nginx los cachea 1 año
    location /_next/static/ {
        proxy_cache next_cache;
        proxy_cache_valid 200 365d;
        proxy_cache_use_stale error timeout updating;
        proxy_pass http://nextjs;
        include /etc/nginx/snippets/proxy.conf;
    }

    location = /api/health {
        access_log off;
        proxy_pass http://nextjs;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        limit_req zone=req_per_ip burst=60 nodelay;
        # Páginas estáticas (SSG): caché corta en Nginx; los cambios llegan con cada despliegue
        proxy_cache next_cache;
        # Next.js envía s-maxage de 1 año para páginas SSG; en Nginx se limita a 10 min
        # (y el script de despliegue vacía la caché).
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_valid 200 301 404 10m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_bypass $http_rsc;
        proxy_cache_key $scheme$host$request_uri$http_rsc$http_next_router_state_tree$http_next_router_prefetch;
        proxy_pass http://nextjs;
        include /etc/nginx/snippets/proxy.conf;
    }
}
