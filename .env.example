# ─────────────────────────────────────────────────────────────
# Configuración central del portal. Copia este archivo a .env
# (o .env.production en el VPS) y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
#
# Las variables NEXT_PUBLIC_* se incrustan en el JavaScript durante
# `npm run build`: si las cambias, hay que volver a construir.
# ─────────────────────────────────────────────────────────────

# SITE_NAME — nombre de la marca (provisional)
NEXT_PUBLIC_SITE_NAME="Calcúlalo"
# SITE_URL — dominio canónico, con https y sin barra final
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# SITE_DESCRIPTION — descripción general del portal
NEXT_PUBLIC_SITE_DESCRIPTION="Calculadoras gratuitas de finanzas, negocios, trabajo y matemáticas. Rápidas, claras y con la fórmula explicada."
# DEFAULT_LOCALE — idioma/región para formato de números (BCP 47)
NEXT_PUBLIC_DEFAULT_LOCALE="es-EC"
# DEFAULT_CURRENCY — moneda por defecto (ISO 4217): USD, MXN, COP, PEN, EUR…
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
# CONTACT_EMAIL — correo público de contacto
NEXT_PUBLIC_CONTACT_EMAIL=""

# GA_ID — ID de medición de Google Analytics 4 (G-XXXXXXXXXX). Vacío = desactivado.
NEXT_PUBLIC_GA_ID=""

# ADSENSE_CLIENT_ID — ca-pub-XXXXXXXXXXXXXXXX. Vacío = sin publicidad.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
# Interruptor general de anuncios: "true" para activarlos (requiere ADSENSE_CLIENT_ID)
NEXT_PUBLIC_ADS_ENABLED="false"
# IDs de bloque de anuncio (data-ad-slot) creados en AdSense para cada ubicación
NEXT_PUBLIC_AD_SLOT_TOOL_IN_CONTENT=""
NEXT_PUBLIC_AD_SLOT_TOOL_BOTTOM=""
NEXT_PUBLIC_AD_SLOT_LISTING=""

# Si es "true", Analytics y anuncios solo se cargan tras aceptar el aviso de cookies.
NEXT_PUBLIC_REQUIRE_CONSENT="true"

# Verificación de Google Search Console mediante meta etiqueta (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
